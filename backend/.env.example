# Server
PORT=4000
NODE_ENV=development

# HIBP API Key (required for email breach check)
# Get yours at: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=your_hibp_api_key_here

# Redis (optional — caching layer)
# Leave blank to run without Redis (in-memory fallback used)
REDIS_URL=redis://localhost:6379

# Cache TTL in seconds (default: 86400 = 24 hours)
CACHE_TTL=86400

# CORS — set to your frontend domain in production
CORS_ORIGIN=http://localhost:5173

# Rate limiting (requests per 15 min per IP)
RATE_LIMIT_MAX=100
